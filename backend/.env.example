# DeepSeek 接入配置。复制为 .env 后填写，不要提交到 Git。
# 未配置 DEEPSEEK_API_KEY 时服务照常运行，只是降级为纯规则模式。

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 单次请求超时（秒）
DEEPSEEK_TIMEOUT=90
# 单次返回上限，字段多时可调大到 8192
DEEPSEEK_MAX_TOKENS=4096

# 模型结论缓存目录，默认 storage/.llm_cache
# LLM_CACHE_DIR=
